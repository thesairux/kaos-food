{
  "buildCommand": "sh herramientas/construir.sh",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/asistente.js": { "includeFiles": "carta.js" },
    "api/estadisticas.js": { "includeFiles": "carta.js" }
  },
  "headers": [
    { "source": "/carta.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/fotos/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
